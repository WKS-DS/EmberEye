# Copy to .env (gitignored) and fill in. Code reads these from the environment.
# Nothing uses them yet; they are the secrets the design calls for.

# Weather (Stage 2): the National Weather Service API asks for a User-Agent with contact details.
NWS_USER_AGENT="EmberEye (you@example.com)"

# Alerts (Stage 1 alerter, later): SMS through Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
